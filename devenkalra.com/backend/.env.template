# ClickUp Personal Access Token
# Get it from: ClickUp settings -> Apps -> Personal Access Tokens
CLICKUP_API_TOKEN=your_personal_access_token_here

# Google & GitHub OAuth Client IDs/Secrets for social subscription
# Google uses authorization-code redirect to /login/google/callback
# (add that exact URI under Authorized redirect URIs in Google Cloud Console).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
