# ClickUp Personal Access Token
# Get it from: ClickUp settings -> Apps -> Personal Access Tokens
CLICKUP_API_TOKEN=your_personal_access_token_here

# Google & GitHub OAuth Client IDs/Secrets for social subscription
# Google uses authorization-code redirect to /login/google/callback
# (add that exact URI under Authorized redirect URIs in Google Cloud Console).
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Email processor (Gmail watch → classify → ClickUp / Static Files)
# Enable Gmail API + Pub/Sub in the same GCP project. Add redirect URI:
#   https://devenkalra.com/api/email/oauth/callback/
EMAIL_WORKER_ENABLED=1
EMAIL_GMAIL_CLIENT_ID=
EMAIL_GMAIL_CLIENT_SECRET=
EMAIL_OAUTH_REDIRECT_URI=https://devenkalra.com/api/email/oauth/callback/
EMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/gmail-push
EMAIL_PUBSUB_VERIFICATION_TOKEN=generate_a_long_random_string
EMAIL_OPENAI_API_KEY=
EMAIL_OPENAI_MODEL=gpt-4.1-mini
LOCALAI_URL=
LOCALAI_API_KEY=
LOCALAI_MODEL=qwen3-32b
# Optional. Cloud IPs are often blocked by YouTube; residential proxies work best.
YOUTUBE_WEBSHARE_USERNAME=
YOUTUBE_WEBSHARE_PASSWORD=
YOUTUBE_HTTP_PROXY=
# Preferred YouTube transcript fallback on production (reuse bldrdojo APIFY_TOKEN).
APIFY_TOKEN=
APIFY_YOUTUBE_TRANSCRIPT_ACTOR=automation-lab/youtube-transcript
EMAIL_ALIAS_ROUTES=writing_idea@kalra.com:writing_idea
EMAIL_CLICKUP_LIST_ID=
EMAIL_CLICKUP_SENDER_FIELD_ID=
EMAIL_CONFIDENCE_AUTO=0.85
EMAIL_COMMAND_SESSION_TTL=3600
FRONTEND_URL=https://devenkalra.com
